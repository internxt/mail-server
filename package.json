{
  "name": "mail-server",
  "version": "0.0.1",
  "description": "Internxt Mail Service API",
  "author": "Internxt",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "migrate": "cross-env NODE_ENV=development sequelize db:migrate",
    "migrate:undo": "cross-env NODE_ENV=development sequelize db:migrate:undo",
    "migrate:prod": "cross-env NODE_ENV=production sequelize db:migrate",
    "migrate:prod:undo": "cross-env NODE_ENV=production sequelize db:migrate:undo",
    "migrate:test": "cross-env NODE_ENV=test sequelize db:migrate",
    "migrate:test:undo": "cross-env NODE_ENV=test sequelize db:migrate:undo",
    "db:seed:all": "cross-env NODE_ENV=development sequelize db:seed:all",
    "db:seed:undo": "cross-env NODE_ENV=development sequelize db:seed:undo:all",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "internxt-crypto": "^1.6.1",
    "nanoid": "^5.1.16",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@golevelup/ts-vitest": "^3.0.0",
    "@internxt/eslint-config-internxt": "2.0.1",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.21",
    "@types/busboy": "^1.5.5",
    "@types/chance": "^1.1.8",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "chance": "^1.1.13",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "./src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.4.2"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
