{
  "name": "mail-server",
  "version": "0.0.1",
  "description": "Internxt Mail Service API",
  "author": "Internxt",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "migrate": "cross-env NODE_ENV=development sequelize db:migrate",
    "migrate:undo": "cross-env NODE_ENV=development sequelize db:migrate:undo",
    "migrate:prod": "cross-env NODE_ENV=production sequelize db:migrate",
    "migrate:prod:undo": "cross-env NODE_ENV=production sequelize db:migrate:undo",
    "migrate:test": "cross-env NODE_ENV=test sequelize db:migrate",
    "migrate:test:undo": "cross-env NODE_ENV=test sequelize db:migrate:undo",
    "db:seed:all": "cross-env NODE_ENV=development sequelize db:seed:all",
    "db:seed:undo": "cross-env NODE_ENV=development sequelize db:seed:undo:all",
    "prepare": "husky"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/common": "^11.1.15",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.15",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.15",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nanoid": "^5.1.5",
    "nestjs-pino": "^4.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@golevelup/ts-vitest": "^3.0.0",
    "@internxt/eslint-config-internxt": "2.0.1",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.15",
    "@swc/core": "^1.15.18",
    "@types/chance": "^1.1.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "chance": "^1.1.13",
    "eslint": "^9.18.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "./src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
